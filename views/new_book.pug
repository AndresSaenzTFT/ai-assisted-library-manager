extends layout

//- Show server-side validation feedback and retain submitted values.
block content
  h2 New Book
  if errors && errors.length
    .validation--errors
      h3 Please correct the following errors:
      ul
        each error in errors
          li= error.message
  form.form--centered(action='/books/new', method='post', novalidate)
    label(for='title') Title
    input#title(type='text', name='title', value=book.title)
    label(for='author') Author
    input#author(type='text', name='author', value=book.author)
    label(for='genre') Genre
    input#genre(type='text', name='genre', value=book.genre)
    label(for='first_published') First Published (Year)
    input#first_published(type='number', name='first_published', value=book.first_published, min='0', step='1', placeholder='e.g. 1997')
    button.button(type='submit') Create Book
  p
    a(href='/books') Back to All Books
